# Copy to .env and fill in. Never commit .env.

APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker        # change in production
POSTGRES_DB=tracker
POSTGRES_PORT=5432               # host port (dev only, bound to 127.0.0.1)
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker   # inside compose the backend overrides host to "postgres"

# Telegram bot token from @BotFather (verifies Mini App initData and runs the bot)
BOT_TOKEN=
BOT_SEND_RATE=25                 # reminder messages per second (Telegram limit is ~30)
MINIAPP_URL=                     # optional: Mini App URL if not https://$DOMAIN/ (e.g. a tunnel)

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET=
JWT_TTL_S=3600                   # access token lifetime
INITDATA_MAX_AGE_S=86400         # how old Telegram initData may be
DEV_AUTH=false                   # true only for local browser development (needs APP_ENV=dev)

# Public domain served by Caddy (automatic HTTPS for real domains)
DOMAIN=localhost
