# Reverse proxy with automatic HTTPS (Telegram Mini Apps and remote MCP require HTTPS).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health* {
		reverse_proxy backend:8000
	}

	# MCP server is added in stage 5.

	# Mini App: static files with long-lived caching (hashed names), served precompressed.
	handle {
		reverse_proxy miniapp:8080
	}
}
