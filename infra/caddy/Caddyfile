# Reverse proxy with automatic HTTPS (Telegram Mini Apps and remote MCP require HTTPS).
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health* {
		reverse_proxy backend:8000
	}

	# Remote MCP server (Streamable HTTP). Auth is the user's bearer token; Caddy only
	# terminates TLS. Access logs are off, so tokens in headers are never written to disk.
	handle /mcp* {
		reverse_proxy mcp:8001
	}

	# Mini App: static files with long-lived caching (hashed names), served precompressed.
	handle {
		reverse_proxy miniapp:8080
	}
}
